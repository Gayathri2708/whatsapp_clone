# Copy this file to .env and fill in real values. .env is gitignored.

NODE_ENV=development
PORT=4000

# Local MongoDB (see docker-compose.yml) or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/whatsapp_clone

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated origins allowed by CORS, or "*" for any.
CORS_ORIGIN=*

# Optional. If unset, the AI Assistant module (Tone Guard / Catch-Me-Up)
# falls back to MockAIProvider so the API works without an Anthropic key.
# Approximate cost per call when set:
#   Tone Guard (claude-haiku-4-5):    ~$0.001 per message
#   Catch-Me-Up (claude-sonnet-4-6):  ~$0.01-0.02 per summary (20-100 messages)
# ANTHROPIC_API_KEY=sk-ant-...
